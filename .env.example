# Kopie als .env anlegen und anpassen. Pfade relativ zum Projektordner oder absolut.

PORT=8080

# weewx-Archiv (wird nur gelesen). Auf dem Debian-Server z. B. /var/lib/weewx/weewx.sdb
WEEWX_DB=data/weewx.sdb

# Eigene Daten der App (Bodensee, Sturmwarnung)
APP_DB=data/app.db

# Hintergrundabrufe Bodensee/Sturmwarnung (0 = aus)
JOBS=1
